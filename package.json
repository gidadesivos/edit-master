{
  "name": "edit-master",
  "private": true,
  "version": "0.2.0",
  "description": "Editor de vídeo gratuito, local e offline — roda no navegador e como app Windows.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
